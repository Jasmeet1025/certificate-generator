{
  "name": "certificate-generator",
  "version": "2.0.0",
  "description": "Prints training certificates: two A5 certificates per A4 page, on a blank certificate design, in one PDF.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "fonts/*-OFL.txt"
  ],
  "scripts": {
    "fonts": "node scripts/embed-fonts.mjs",
    "build": "node scripts/embed-fonts.mjs && tsc -p tsconfig.json",
    "prepare": "npm run build",
    "background": "node scripts/make-background.mjs",
    "sample": "node scripts/sample.mjs",
    "dev": "node scripts/embed-fonts.mjs && vite",
    "build:web": "node scripts/embed-fonts.mjs && tsc -p web/tsconfig.json && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@fontsource/barlow": "^5.2.5",
    "@fontsource/barlow-condensed": "^5.2.5",
    "@types/node": "^22.10.0",
    "pdfjs-dist": "^4.10.38",
    "typescript": "^5.7.0",
    "vite": "^6.3.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "license": "UNLICENSED"
}
